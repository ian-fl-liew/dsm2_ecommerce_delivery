# Copy to ingestion/.dlt/secrets.toml (gitignored) and fill in real values.
# See docs/mongodb_setup.md and docs/gcp_setup.md.

[destination.mongodb]
connection_url = "mongodb+srv://<your_atlas_user>:<password>@<cluster>.mongodb.net"

[sources.mongodb]
connection_url = "mongodb+srv://<your_atlas_user>:<password>@<cluster>.mongodb.net"

[destination.bigquery]
# No key file needed if using `gcloud auth application-default login` (method="oauth"
# in dbt profiles.yml); dlt's BigQuery destination picks up the same ADC credentials.
location = "US"
